# FLASH CAM Environment Variables
# Add these in Netlify: Project Settings > Environment variables > Import .env

# Google Gemini Vision API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Node Environment
NODE_ENV=production

# Application Branding
VITE_APP_TITLE=FLASH CAM - AI Surveillance & Forensic Workspace
